# Copy this file to ".amo-credentials" (which is gitignored) and fill in your
# AMO API credentials. Generate them at:
#   https://addons.mozilla.org/developers/addon/api/key/
#
# Then run a release with:  ./release.sh 0.1.3
#
# Keep .amo-credentials private — never commit it.

export AMO_JWT_ISSUER="user:XXXXXXX:XXX"
export AMO_JWT_SECRET="your-long-jwt-secret-here"
